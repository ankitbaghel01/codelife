  "statement": "Students typed project tags with letters in random order. Group tags that use exactly the same letters.\n\nGiven a list of lowercase strings `words`, group the words that are **anagrams** of each other (same letters, same counts). Return a list of groups. **Inside each group, sort the words alphabetically.** The groups themselves can be in any order. Duplicate words stay in their group.",
  "function": {
    "name": "group_anagrams",
    "params": [
      {
        "name": "words",
        "type": "list[str]"
      }
    ],
    "returns": "list[list[str]]"
  },
  "constraints": [
    "0 <= len(words) <= 10^4",
    "0 <= len(words[i]) <= 100",
    "words contain only a-z"
  ],
  "examples": [
    {
      "args": [
        [
          "listen",
          "tab",
          "silent",
          "bat",
          "cat"
        ]
      ],
      "expected": [
        [
          "listen",
          "silent"
        ],
        [
          "bat",
          "tab"
        ],
        [
          "cat"
        ]
      ],
      "explanation": "listen/silent and tab/bat share letters; cat is alone."
    },
    {
      "args": [
        [
          ""
        ]
      ],
      "expected": [
        [
          ""
        ]
      ],
      "explanation": "An empty string forms its own group."
    }
  ],
  "starter": {
