  "statement": "The campus network has `n` routers numbered `0` to `n - 1`, linked by two-way cables.\n\nGiven `n`, a list of `edges` where `[u, v]` is a cable between `u` and `v`, and two routers `start` and `end`, return the **fewest cables** a message must cross to get from `start` to `end`, or `-1` if it cannot get there. From a router to itself is 0.",
  "function": {
    "name": "fewest_hops",
    "params": [
      {
        "name": "n",
        "type": "int"
      },
      {
        "name": "edges",
        "type": "list[list[int]]"
      },
      {
        "name": "start",
        "type": "int"
      },
      {
        "name": "end",
        "type": "int"
      }
    ],
    "returns": "int"
  },
  "constraints": [
    "1 <= n <= 10^4",
    "0 <= len(edges) <= 2 * 10^4",
    "0 <= u, v, start, end < n"
  ],
