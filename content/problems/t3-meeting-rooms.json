  "statement": "Facilities must book enough classrooms so no two overlapping sessions share a room.\n\nGiven a list of `sessions` where each is `[start, end]` with `start < end`, return the **minimum number of rooms** needed. A session ending at time `t` frees its room for a session starting at `t`.",
  "function": {
    "name": "rooms_needed",
    "params": [
      {
        "name": "sessions",
        "type": "list[list[int]]"
      }
    ],
    "returns": "int"
  },
  "constraints": [
    "0 <= len(sessions) <= 10^4",
    "0 <= start < end <= 10^6"
  ],
  "examples": [
    {
      "args": [
        [
          [
            0,
            30
          ],
          [
            5,
            10
          ],
          [
            15,
            20
          ]
        ]
      ],
      "expected": 2,
      "explanation": "[0,30] overlaps both others, but [5,10] and [15,20] can share a room."
    },
    {
      "args": [
        [
          [
            1,
            5
          ],
          [
            5,
            9
          ]
        ]
      ],
      "expected": 1,
      "explanation": "The second session starts exactly when the first ends."
    }
  ],
