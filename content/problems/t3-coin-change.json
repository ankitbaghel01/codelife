  "hints": [
    "Greedy fails on [1, 3, 4] with amount 6 (4+1+1 vs 3+3). Think about smaller amounts first.",
    "Let best[a] be the fewest coins for amount a. Each coin c gives a candidate best[a - c] + 1.",
    "best = [0] + [inf] * amount; for a in 1..amount, for c in coins, if c <= a: best[a] = min(best[a], best[a - c] + 1). Return -1 if best[amount] is still inf."
  ],
  "followUps": [
