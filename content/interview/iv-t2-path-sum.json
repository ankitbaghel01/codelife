  ],
  "statement": "A treasure map is a binary tree of numbers. Return `True` if some path from the **root down to a leaf** (a node with no children) adds up exactly to `target`, otherwise `False`. An empty tree has no paths.\n\nTrees are passed as a `TreeNode` (with `.val`, `.left`, `.right`; the class is already defined). In examples a tree is written level by level, with `None` for a missing child.",
  "function": {
    "name": "has_path_sum",
    "params": [
      {
        "name": "root",
        "type": "TreeNode"
      },
      {
        "name": "target",
        "type": "int"
      }
    ],
    "returns": "bool"
  },
  "constraints": [
    "0 <= number of nodes <= 5000",
    "-1000 <= node value <= 1000"
  ],
  "examples": [
    {
      "args": [
        [
          5,
          4,
          8,
          11,
          null,
          13,
          4,
          7,
          2
        ],
        22
      ],
      "expected": true,
      "explanation": "5 -> 4 -> 11 -> 2 adds up to 22."
    },
    {
      "args": [
        [
          1,
          2,
          3
        ],
        5
      ],
      "expected": false,
      "explanation": "Root-to-leaf sums are 3 and 4."
    }
  ],
  "starter": {
    "python": "def has_path_sum(root, target):\n    # Write your solution here\n    pass\n"
  },
