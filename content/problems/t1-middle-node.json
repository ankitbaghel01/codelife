          1,
          2,
          3,
          4,
          5
        ]
      ],
      "expected": [
        3,
        4,
        5
      ],
      "explanation": "The middle of five nodes is the third."
    },
    {
      "args": [
        [
          1,
          2,
          3,
          4
        ]
      ],
      "expected": [
        3,
        4
      ],
      "explanation": "With two middles (2 and 3), return the second."
    }
  ],
