  "statement": "The vending machine must give back change using as few coins as possible.\n\nGiven a list of coin values `coins` (unlimited supply of each) and an integer `amount`, return the **minimum number of coins** that add up to exactly `amount`, or `-1` if it cannot be done. An amount of 0 needs 0 coins. Note that always grabbing the biggest coin does not always work.",
  "function": {
    "name": "min_coins",
    "params": [
      {
        "name": "coins",
        "type": "list[int]"
      },
      {
        "name": "amount",
        "type": "int"
      }
    ],
    "returns": "int"
  },
  "constraints": [
    "1 <= len(coins) <= 12",
    "1 <= coins[i] <= 10^4",
    "0 <= amount <= 10^4"
  ],
  "examples": [
    {
      "args": [
        [
          1,
          2,
          5
        ],
        11
      ],
      "expected": 3,
      "explanation": "5 + 5 + 1."
    },
    {
      "args": [
        [
          2
        ],
        3
      ],
      "expected": -1,
      "explanation": "Only even amounts can be made with 2s."
    }
  ],
