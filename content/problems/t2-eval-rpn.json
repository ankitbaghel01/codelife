  "hintsPolicy": {
    "interview": "ladder",
    "steps": [
      "nudge",
      "data structure",
      "partial approach"
    ]
  },
  "hints": [
    "Numbers wait until an operator comes along to use them.",
    "Push numbers on a stack; an operator pops the top two values.",
    "Pop b then a (order matters for - and /), push the result of a op b. For division use int(a / b) to truncate toward zero, not a // b."
  ],
  "followUps": [
    "How would you convert a normal infix expression like (3 + 4) * 2 into postfix?"
  ],
