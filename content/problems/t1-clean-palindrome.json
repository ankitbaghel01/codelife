        "type": "str"
      }
    ],
    "returns": "bool"
  },
  "constraints": [
    "0 <= len(text) <= 10^5",
    "Only English letters a-z / A-Z count; everything else is ignored"
  ],
  "examples": [
    {
      "args": [
        "Never odd or even"
      ],
      "expected": true,
      "explanation": "Letters give 'neveroddoreven', which reads the same both ways."
    },
    {
      "args": [
        "CodeLife"
      ],
      "expected": false,
      "explanation": "'codelife' reversed is 'efiledoc'."
    }
  ],
