      }
    ],
    "returns": "list[int]"
  },
  "constraints": [
    "0 <= len(changes) <= 10^5",
    "-10^6 <= start, changes[i] <= 10^6"
  ],
  "examples": [
    {
      "args": [
        100,
        [
          50,
          -30,
          10
        ]
      ],
      "expected": [
        150,
        120,
        130
      ],
      "explanation": "100+50=150, 150-30=120, 120+10=130."
    },
    {
      "args": [
        0,
        [
          -5
        ]
      ],
      "expected": [
        -5
      ],
      "explanation": "The balance may go negative."
    }
  ],
