  "statement": "A password checker rewards long runs of characters that never repeat.\n\nGiven a string `s`, return the length of the **longest substring** (contiguous) in which **no character appears twice**.",
  "function": {
    "name": "longest_unique_run",
    "params": [
      {
        "name": "s",
        "type": "str"
      }
    ],
    "returns": "int"
  },
  "constraints": [
    "0 <= len(s) <= 10^5",
    "s may contain letters, digits, symbols and spaces"
  ],
  "examples": [
    {
      "args": [
        "abcabcbb"
      ],
      "expected": 3,
      "explanation": "\"abc\" is the longest run with no repeats."
    },
    {
      "args": [
        "bbbb"
      ],
      "expected": 1,
      "explanation": "Every run longer than one repeats 'b'."
    }
  ],
  "starter": {
    "python": "def longest_unique_run(s):\n    # Write your solution here\n    pass\n"
  },
