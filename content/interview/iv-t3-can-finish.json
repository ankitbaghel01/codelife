  "statement": "A university has `n` courses numbered `0` to `n - 1`. Each pair `[a, b]` in `prereqs` means you must finish course `b` before course `a`.\n\nReturn `True` if it is possible to finish **every** course, or `False` if some prerequisites form a loop.",
  "function": {
    "name": "can_finish",
    "params": [
      {
        "name": "n",
        "type": "int"
      },
      {
        "name": "prereqs",
        "type": "list[list[int]]"
      }
    ],
    "returns": "bool"
  },
  "constraints": [
    "1 <= n <= 2000",
    "0 <= len(prereqs) <= 5000",
    "0 <= a, b < n"
  ],
  "examples": [
    {
      "args": [
        2,
        [
          [
            1,
            0
          ]
        ]
      ],
      "expected": true,
      "explanation": "Take 0, then 1."
    },
    {
      "args": [
        2,
        [
          [
            1,
            0
          ],
          [
            0,
            1
          ]
        ]
      ],
      "expected": false,
      "explanation": "Each course needs the other first: a loop."
    }
  ],
  "starter": {
    "python": "def can_finish(n, prereqs):\n    # Write your solution here\n    pass\n"
  },
