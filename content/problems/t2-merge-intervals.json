        "name": "intervals",
        "type": "list[list[int]]"
      }
    ],
    "returns": "list[list[int]]"
  },
  "constraints": [
    "0 <= len(intervals) <= 10^4",
    "0 <= start <= end <= 10^6",
    "intervals may come in any order"
  ],
  "examples": [
