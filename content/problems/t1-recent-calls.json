  "statement": "The API gateway counts how busy it is over the last three seconds.\n\nGiven `times`, a list of request timestamps in milliseconds in **strictly increasing** order, return a list where entry `i` is the number of requests whose time is in the range `[times[i] - 3000, times[i]]` (both ends included), counting request `i` itself.",
  "function": {
    "name": "count_recent",
    "params": [
      {
        "name": "times",
        "type": "list[int]"
      }
    ],
    "returns": "list[int]"
  },
  "constraints": [
    "0 <= len(times) <= 10^5",
    "1 <= times[i] <= 10^9",
    "times is strictly increasing"
  ],
  "examples": [
    {
      "args": [
        [
          1,
          100,
          3001,
          3002
        ]
      ],
      "expected": [
        1,
        2,
        3,
        3
      ],
      "explanation": "At 3001 the window [1, 3001] holds 3 requests; at 3002 the request at 1 has dropped out."
    },
    {
      "args": [
        [
          5000
        ]
      ],
      "expected": [
        1
      ],
      "explanation": "A single request counts itself."
    }
  ],
  "starter": {
    "python": "def count_recent(times):\n    # Write your solution here\n    pass\n"
  },
