  "statement": "The ed-tech app shows kids a vowel/consonant meter for each word they type.\n\nGiven `text`, return a list `[vowels, consonants]` counting the English letters in it. Vowels are `a e i o u` (any case). Every other English letter, including `y`, is a consonant. Ignore digits, spaces and punctuation.",
  "function": {
    "name": "count_letters",
    "params": [
      {
        "name": "text",
        "type": "str"
      }
    ],
    "returns": "list[int]"
  },
  "constraints": [
    "0 <= len(text) <= 10^5"
  ],
  "examples": [
    {
      "args": [
        "Hello World"
      ],
      "expected": [
        3,
        7
      ],
      "explanation": "Vowels: e, o, o. Consonants: H, l, l, W, r, l, d."
    },
    {
      "args": [
        "2024!"
      ],
      "expected": [
        0,
        0
      ],
      "explanation": "No letters at all."
    }
  ],
  "starter": {
    "python": "def count_letters(text):\n    # Write your solution here\n    pass\n"
  },
  "visibleTests": [
    {
