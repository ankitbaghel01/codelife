  "statement": "A delivery bike passes fuel stations in order; `nums[i]` is the litres you can buy at station `i` (always positive).\n\nReturn the length of the **shortest run of consecutive stations** whose litres add up to **at least** `target`. Return `0` if no run is enough.",
  "function": {
    "name": "shortest_window",
    "params": [
      {
        "name": "target",
        "type": "int"
      },
      {
        "name": "nums",
        "type": "list[int]"
      }
    ],
    "returns": "int"
  },
  "constraints": [
    "1 <= target <= 10^9",
    "0 <= len(nums) <= 10^5",
    "1 <= nums[i] <= 10^4"
  ],
  "examples": [
    {
      "args": [
        7,
        [
          2,
          3,
          1,
          2,
          4,
          3
        ]
      ],
      "expected": 2,
      "explanation": "[4, 3] sums to 7 with length 2."
    },
    {
      "args": [
        15,
        [
          1,
          2,
          3,
          4,
          5
        ]
      ],
      "expected": 5,
      "explanation": "Only the whole list reaches 15."
    }
  ],
  "starter": {
    "python": "def shortest_window(target, nums):\n    # Write your solution here\n    pass\n"
  },
  "visibleTests": [
    {
