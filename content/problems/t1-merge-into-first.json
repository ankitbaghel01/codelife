      },
      {
        "name": "b",
        "type": "list[int]"
      },
      {
        "name": "n",
        "type": "int"
      }
    ],
    "returns": "list[int]"
  },
  "constraints": [
    "len(a) == m + n",
    "len(b) == n",
    "0 <= m, n <= 10^4",
    "the real part of a and all of b are sorted"
  ],
  "examples": [
